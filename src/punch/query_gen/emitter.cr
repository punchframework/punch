require "compiler/crystal/tools/formatter"

module Punch::QueryGen
  # Writes the generated Crystal. Output goes through Crystal's formatter, so
  # a committed file passes `crystal tool format --check` and a staleness
  # check compares like with like.
  module Emitter
    # SQLite's keywords, which must be quoted as column or table names.
    SQL_KEYWORDS = %w[abort action add after all alter always analyze and as asc attach autoincrement before begin between by
      cascade case cast check collate column commit conflict constraint create cross current current_date current_time
      current_timestamp database default deferrable deferred delete desc detach distinct do drop each else end escape
      except exclude exclusive exists explain fail filter first following for foreign from full generated glob group
      groups having if ignore immediate in index indexed initially inner insert instead intersect into is isnull join key
      last left like limit match materialized natural no not nothing notnull null nulls of offset on or order others
      outer over partition plan pragma preceding primary query raise range recursive references regexp reindex release
      rename replace restrict returning right rollback row rows savepoint select set table temp temporary then ties to
      transaction trigger unbounded union unique update using vacuum values view virtual when where window with without]

    def self.format(code : String, path : String) : String
      Crystal.format(code, filename: path)
    end

    def self.header(io : IO, sources : String) : Nil
      io << "# Generated by `punch db:generate` from " << sources << ". Do not edit:\n"
      io << "# change the source and run `punch db:generate` again.\n\n"
    end

    # `records.gen.cr`: a record and per-table CRUD for each of *tables*,
    # the tables one `columns.cr` maps. The rowid's violation is written
    # only when a query in *used* can violate it, by inserting or changing
    # an ID.
    def self.records(schema : Schema, tables : Array(Schema::Table), sources : String, used : Set(Schema::Unique) = Set(Schema::Unique).new,
                     composites : Array(Composite) = [] of Composite) : String
      String.build do |io|
        header(io, sources)
        composite_structs(io, schema, composites)
        io << '\n' unless composites.empty? || tables.empty?
        tables = tables.sort_by(&.name)
        tables.each_with_index do |table, index|
          io << '\n' if index > 0
          record(io, schema, table, used)
        end
        audited = tables.select { |table| audited?(table) }
        unless audited.empty?
          io << "\n# Every mapped column is parsed by `punch db:audit` and the nightly audit job.\n"
          audited.each do |table|
            io << "Punch::Database::Audit.table(" << table.name.inspect << ") { |db, after, limit, audit| " << table.mod << "::Table.audit(db, after, limit, audit) }\n"
          end
        end
        reencrypted = tables.select { |table| reencrypted?(table) }
        unless reencrypted.empty?
          io << "\n# Encrypted columns are brought to the signing key by `punch db:encrypt` and the nightly job.\n"
          reencrypted.each do |table|
            io << "Punch::Database::Encryption.table(" << table.name.inspect << ") { |db, after, limit, run| " << table.mod << "::Table.reencrypt(db, after, limit, run) }\n"
          end
        end
        upgraded = tables.select { |table| !documents(schema, table).empty? && !table.without_rowid? }
        unless upgraded.empty?
          io << "\n# Documents are rewritten in their composite's current version by `punch db:upgrade` and the nightly job.\n"
          upgraded.each do |table|
            io << "Punch::Database::Upgrade.table(" << table.name.inspect << ") { |db, after, limit, run| " << table.mod << "::Table.upgrade(db, after, limit, run) }\n"
          end
        end
      end
    end

    # A table is audited when a column maps to a domain type and rows have
    # a rowid to resume after.
    private def self.audited?(table : Schema::Table) : Bool
      !table.without_rowid? && table.columns.any? { |column| column.type.try(&.domain) }
    end

    private def self.record(io : IO, schema : Schema, table : Schema::Table, used : Set(Schema::Unique)) : Nil
      columns = table.record_columns.map do |column|
        ResultColumn.new(column.name, column.type || Type.new("String"), Source::Metadata, table.name, column.name)
      end
      io << "module " << table.mod << '\n'
      io << "  # A row of `" << table.name << "`, reused by every query that selects the whole row.\n"
      table.behaviour.try { |path| io << "  # Its behaviour goes in `" << path << "`, which reopens this struct.\n" }
      row_struct(io, schema, "Record", columns, table.name, rowids(schema, columns))
      io << '\n'
      table.uniques.each do |unique|
        # The rowid's, when a query or Table.insert can set it.
        next if unique.rowid? && !used.includes?(unique) && !table.foreign_keys.includes?(unique.columns.first)
        violation(io, table, unique)
        io << '\n'
      end
      crud(io, schema, table)
      io << "end\n"
    end

    # A `record` with a `read` that parses every mapped column, including
    # the given behaviour modules. A blind index is read past, not kept:
    # its hash means nothing to the app.
    private def self.row_struct(io : IO, schema : Schema, name : String, all : Array(ResultColumn), context : String, rowids : Array(ResultColumn),
                                includes : Array(String) = [] of String) : Nil
      # A plaintext column being converted feeds its encrypted column's
      # value when both are selected (`from(:email)`).
      columns = all.reject { |column| column.type.blind || feeding?(column, all) }
      # A group whose columns are all selected is one field (docs/composites.md).
      folded = folded_groups(schema, all)
      fields = record_fields(columns, all, folded)
      io << "  record " << name << (fields.empty? ? " do\n" : ",\n")
      fields.each_with_index do |(field, type, _), index|
        io << "    " << field << " : " << type << (index < fields.size - 1 ? ",\n" : " do\n")
      end
      includes.each { |mod| io << "    include " << mod << '\n' }
      io << '\n' unless includes.empty?
      io << "    def self.read(row : Punch::Database::Row) : self\n"
      all.each do |column|
        if column.type.blind
          io << "      row.read(" << column.type.stored_crystal << ") # " << column.name << ", a blind index\n"
        elsif feeding?(column, all)
          io << "      " << local(column.name) << " = row.read(" << column.type.stored_crystal << ") # the plaintext, until " << column.type.plaintext_of << " has it\n"
        else
          io << "      " << local(column.name) << " = row.read(" << column.type.stored_crystal << ")\n"
        end
      end
      io << "      new(\n"
      fields.each do |field, _, column|
        if column
          io << "        " << field << ": " << load(column, context, rowids, all) << ",\n"
        else
          group = folded.values.find!(&.field.==(field))
          members = all.select { |candidate| folded[candidate]? == group }
          io << "        " << field << ": " << group_value(schema, group, group.composite, [] of String, group.nilable?, members, context, rowids) << ",\n"
        end
      end
      io << "      )\n    end\n\n"
      io << "    # A database row is not a response: serializing one does not compile.\n"
      io << "    def to_json(json : JSON::Builder) : Nil\n"
      io << "      {% raise \"\#{@type} is a database row, not a response: return a result struct with the fields to show (lib/punch/docs/openapi.md)\" %}\n"
      io << "    end\n  end\n"
    end

    # The fields of a row: each column under its name, or a group's
    # composite in place of its first column.
    private def self.record_fields(columns : Array(ResultColumn), all : Array(ResultColumn), folded : Hash(ResultColumn, Schema::Group)) : Array({String, String, ResultColumn?})
      columns.compact_map do |column|
        if group = folded[column]?
          next unless group.columns.first.name == column.origin
          next {group.field, "#{group.composite.name}#{group.nilable? ? "?" : ""}", nil.as(ResultColumn?)}
        end
        # Without its plaintext column selected, a converted column is only its ciphertext.
        type = column.type.filled && !fed?(column, all) ? column.type.copy_with(filled: false) : column.type
        {column.name, type.crystal, column.as(ResultColumn?)}
      end
    end

    # The value a write returns when it violates *unique*.
    private def self.violation(io : IO, table : Schema::Table, unique : Schema::Unique) : Nil
      return trigger_violation(io, table, unique) if unique.trigger?

      what = if unique.rowid?
               "this #{unique.columns.first} (the rowid)"
             elsif unique.columns.empty?
               "a value of the index #{unique.name}"
             else
               "this #{unique.columns.join(", ")}"
             end
      io << "  # Another `" << table.name << "` row has " << what << ". Returned by the writes that can violate it.\n"
      io << "  struct " << unique.type_name << "\n"
      io << "    include Punch::Database::Violation\n\n"
      io << "    CONSTRAINT = " << unique.constraint(table.name).inspect << '\n'
      io << "    FIELD = " << (unique.field.try(&.inspect) || "nil") << '\n'
      io << "    MESSAGE = " << unique.message.inspect << '\n'
      io << "  end\n"
    end

    # The value a write returns when a trigger refuses it with
    # `RAISE(ABORT, 'punch:<code>')` (`Punch.violation`): answered with
    # its status, 422 like a rejected input or 409 as a problem, and its
    # code.
    private def self.trigger_violation(io : IO, table : Schema::Table, unique : Schema::Unique) : Nil
      io << "  # `" << table.name << "` refused the write: `RAISE(ABORT, '" << unique.message << "')` in " << unique.name << ".\n"
      io << "  # Returned by the writes that fire it; declared in " << (table.mapped_in || "columns.cr") << ".\n"
      io << "  @[Punch::Status(" << unique.status << ")]\n" unless unique.status == 422
      io << "  struct " << unique.type_name << "\n"
      io << "    include Punch::Database::" << (unique.status == 422 ? "Violation" : "Refusal") << "\n\n"
      io << "    CONSTRAINT = " << unique.constraint(table.name).inspect << '\n'
      io << "    FIELD = " << (unique.field.try(&.inspect) || "nil") << '\n' if unique.status == 422
      io << "    MESSAGE = " << unique.message.inspect << '\n'
      io << "    PROBLEM_CODE = " << unique.code.inspect << '\n'
      io << "  end\n"
    end

    # The result type of a write with its violations: `Record | EmailTaken`.
    private def self.with_violations(result : String, violations : Array(Schema::Unique), prefix : String = "") : String
      ([result] + violations.map { |unique| "#{prefix}#{unique.type_name}" }).join(" | ")
    end

    # Turns the failure of a constraint the write can violate into its
    # value; any other failure stays an exception.
    private def self.rescue_violations(io : IO, violations : Array(Schema::Unique), prefix : String = "") : Nil
      return if violations.empty?

      io << "    rescue ex : Punch::Database::ConstraintError\n"
      io << "      case ex.detail\n"
      violations.each do |unique|
        name = "#{prefix}#{unique.type_name}"
        io << "      when " << name << "::MESSAGE then " << name << ".new\n"
      end
      io << "      else raise ex\n"
      io << "      end\n"
    end

    private def self.local(name : String) : String
      name == "row" ? "row_" : name
    end

    # Whether *column* is a plaintext column whose encrypted column is in
    # *all* too, and so is read into it.
    private def self.feeding?(column : ResultColumn, all : Array(ResultColumn)) : Bool
      target = column.type.plaintext_of || return false
      all.any? { |other| other.type.from == column.origin && other.origin == target && other.table == column.table }
    end

    # Whether the converted column *column* has its plaintext column in *all*.
    private def self.fed?(column : ResultColumn, all : Array(ResultColumn)) : Bool
      !plain_of(column, all).nil?
    end

    private def self.plain_of(column : ResultColumn, all : Array(ResultColumn)) : ResultColumn?
      from = column.type.from || return
      all.find { |other| other.origin == from && other.table == column.table && feeding?(other, all) }
    end

    private def self.load(column : ResultColumn, context : String, rowids : Array(ResultColumn), all : Array(ResultColumn) = [] of ResultColumn) : String
      domain = column.type.domain
      return local(column.name) unless domain

      plain = plain_of(column, all)
      return converting_load(column, plain, context, rowids) if plain

      arguments = load_arguments(column, context, rowids)
      if column.type.nullable
        "#{local(column.name)}.try { |value| Punch::Stored.load(#{domain}, value, #{arguments}) }"
      else
        "Punch::Stored.load(#{domain}, #{local(column.name)}, #{arguments})"
      end
    end

    # The table, column, and row ID a value's `Punch::Stored.load` names
    # when it does not parse.
    private def self.load_arguments(column : ResultColumn, context : String, rowids : Array(ResultColumn)) : String
      table, origin = column.table, column.origin
      table, origin = context, column.name unless table && origin
      # The row ID for the message: the table's rowid column, if selected.
      "#{table.inspect}, #{origin.inspect}, #{row_id_of(column, rowids)}"
    end

    private def self.row_id_of(column : ResultColumn, rowids : Array(ResultColumn)) : String
      rowid = column.table.try { |name| rowids.find(&.table.==(name)) }
      rowid ? local(rowid.name) : "nil"
    end

    # The groups of *columns* to read as one field each: every column of the
    # group selected under its own name, and, for a group that cannot be
    # absent, none of them NULL (an outer join can make them).
    private def self.folded_groups(schema : Schema, columns : Array(ResultColumn)) : Hash(ResultColumn, Schema::Group)
      members = {} of ResultColumn => Schema::Group
      columns.each do |column|
        next unless column.source.metadata? && column.name == column.origin
        group = column.table.try { |table| column.origin.try { |origin| schema.column(table, origin) } }.try(&.group) || next
        members[column] = group
      end
      members.select do |_, group|
        selected = members.select { |_, other| other == group }.keys
        group.columns.all? { |member| selected.any?(&.origin.==(member.name)) } &&
          (group.nilable? || Groups.required_columns(schema, group, [] of String).none? { |member| selected.find!(&.origin.==(member.name)).type.nullable })
      end
    end

    # The composite under *path* of a group, from its columns' values: each
    # parsed into its field's type, then the composite built and checked.
    # A nilable one is `nil` when all its columns are NULL; then its required
    # columns must all be there.
    private def self.group_value(schema : Schema, group : Schema::Group, composite : Composite, path : Array(String), nilable : Bool,
                                 members : Array(ResultColumn), context : String, rowids : Array(ResultColumn)) : String
      required = Groups.required_columns(schema, group, path).map(&.name)
      values = composite.fields.map do |field|
        if field.type.kind.composite?
          nested = schema.composites[field.type.name]? || raise "no composite #{field.type.name}"
          next group_value(schema, group, nested, path + [field.name], field.type.nilable?, members, context, rowids)
        end
        column = members.find! { |member| member.origin == "#{group.prefix}#{(path + [field.name]).join('_')}" }
        if column.type.nullable && required.includes?(column.origin || "")
          raw = "Punch::Composite.present(#{local(column.name)}, #{load_arguments(column, context, rowids)})"
          column.type.domain ? "Punch::Stored.load(#{column.type.domain}, #{raw}, #{load_arguments(column, context, rowids)})" : raw
        else
          load(column, context, rowids)
        end
      end
      prefix = "#{group.prefix}#{path.map { |name| "#{name}_" }.join}"
      table = members.first.table || context
      built = "#{composite.name}.punch_group(#{values.join(", ")}, #{table.inspect}, #{prefix.inspect}, #{row_id_of(members.first, rowids)})"
      return built unless nilable

      locals = Groups.group_columns(group, path).map { |member| local(members.find!(&.origin.==(member.name)).name) }
      "(Punch::Composite.absent?(#{locals.join(", ")}) ? nil : #{built})"
    end

    # An encrypted column read from its ciphertext, else from the plaintext
    # column it replaces (`from(:email)`), parsed and wrapped.
    private def self.converting_load(column : ResultColumn, plain : ResultColumn, context : String, rowids : Array(ResultColumn)) : String
      table = column.table || context
      rowid = rowids.find(&.table.==(column.table)).try { |found| local(found.name) } || "nil"
      inner = plain.type.domain
      decrypted = "Punch::Stored.load(#{column.type.domain}, value, #{table.inspect}, #{column.origin.inspect}, #{rowid})"
      fallback = ->(value : String) { "Punch::Secret.new(Punch::Stored.load(#{inner}, #{value}, #{table.inspect}, #{plain.origin.inspect}, #{rowid}))" }
      plain_value = plain.type.nullable ? "#{local(plain.name)}.try { |plain| #{fallback.call("plain")} }" : fallback.call(local(plain.name))
      "#{local(column.name)}.try { |value| #{decrypted} } || #{plain_value}"
    end

    # The result columns that hold a table's rowid, for error messages.
    private def self.rowids(schema : Schema, columns : Array(ResultColumn)) : Array(ResultColumn)
      columns.select do |column|
        (table = column.table.try { |name| schema.table(name) }) && (rowid = table.rowid) && rowid.name == column.origin
      end
    end

    private def self.quote(name : String) : String
      SQL_KEYWORDS.includes?(name.downcase) || !name.matches?(/\A[A-Za-z_][A-Za-z0-9_]*\z/) ? %("#{name.gsub('"', "\"\"")}") : name
    end

    private def self.argument(name : String, type : Type) : String
      if type.array
        blind = type.blind.try(&.split('.', 2))
        return blind ? "Punch::Stored.blind_lookups(#{name}, #{blind[0].inspect}, #{blind[1].inspect})" : "Punch::Stored.array(#{name})"
      end
      if encrypted = type.encrypted
        table, column = encrypted.split('.', 2)
        "Punch::Stored.encrypt(#{name}, #{table.inspect}, #{column.inspect})"
      elsif blind = type.blind
        table, column = blind.split('.', 2)
        "Punch::Stored.blind_#{type.lookup ? "lookup" : "index"}(#{name}, #{table.inspect}, #{column.inspect})"
      else
        type.domain ? "Punch::Stored.dump(#{name})" : name
      end
    end

    # What Crystal would read as an escape sequence or interpolation; the
    # pattern of Ameba's Style/HeredocEscape, which generated code passes.
    # `#{` counts after a backslash too: doubling the backslash would leave
    # the interpolation live.
    ESCAPE_LIKE = /#\{|(?<!\\)\\(?:[abefnrtv]|[CdDhHRsSvVwWX]|[0-7]{1,3}|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4}|u\{[0-9a-fA-F]{1,6}\})/

    # SQL as a heredoc constant that reads as written: a raw heredoc when
    # the SQL holds something like an escape or interpolation, else a
    # plain one with backslashes doubled. The terminator is one no line of
    # the SQL is, so a line `SQL` in a string literal cannot end it.
    # :nodoc:
    def self.heredoc(io : IO, constant : String, sql : String) : Nil
      raw = sql.matches?(ESCAPE_LIKE)
      terminator = "SQL"
      while sql.each_line.any?(&.strip.==(terminator))
        terminator += "_END"
      end
      io << "    " << constant << " = " << (raw ? "<<-'#{terminator}'" : "<<-#{terminator}") << '\n'
      sql.each_line do |line|
        text = raw ? line : line.gsub('\\', "\\\\")
        io << (line.blank? ? "" : "      #{text}") << '\n'
      end
      io << "      " << terminator << '\n'
    end

    # Whether SQLite assigns *column*: the rowid, unless it references
    # another table's row.
    private def self.assigned_rowid?(table : Schema::Table, column : Schema::Column) : Bool
      column == table.rowid && !table.foreign_keys.includes?(column.name)
    end

    private def self.crud(io : IO, schema : Schema, table : Schema::Table) : Nil
      io << "  # Find, insert, update, and delete `" << table.name << "` rows by primary key.\n"
      io << "  module Table\n"
      sections = [] of String
      key = table.primary_key
      sections << crud_find(table, key) unless key.empty?
      inserted = table.record_columns.reject { |column| column.generated? || assigned_rowid?(table, column) }
      sections << crud_insert(schema, table, inserted) unless inserted.empty?
      updated = table.record_columns.reject { |column| column.generated? || column.pk.positive? }
      sections << crud_update(schema, table, key, updated) unless key.empty? || updated.empty?
      sections << crud_delete(table, key) unless key.empty?
      sections << crud_audit(table) if audited?(table)
      sections << crud_reencrypt(table) if reencrypted?(table)
      documents = documents(schema, table)
      sections << crud_upgrade(table, documents) unless documents.empty? || table.without_rowid?
      rowid_reuse(table).try { |section| sections << section }
      io << sections.join('\n') << "  end\n"
    end

    # Without `AUTOINCREMENT`, SQLite gives the rowid of a deleted last row
    # to the next row (`Punch::TypedID.reusing_rowids`).
    # A rowid that references another table's is not SQLite's to assign.
    private def self.rowid_reuse(table : Schema::Table) : String?
      rowid = table.rowid || return
      type = rowid.type.try(&.domain) || return
      return if table.autoincrement? || table.foreign_keys.includes?(rowid.name)

      "    Punch::TypedID.reusing_rowids ::#{type.lchop("::")}, #{table.name.inspect}\n"
    end

    private def self.crud_find(table : Schema::Table, key : Array(Schema::Column)) : String
      String.build do |io|
        heredoc(io, "FIND", "SELECT #{column_list(table)}\nFROM #{quote(table.name)}\nWHERE #{key_condition(key)}")
        io << "\n    def self.find(db : Punch::Reader | Punch::Writer, " << key_parameters(key) << ") : Record?\n"
        io << "      db.query_one?(FIND, " << key.join(", ") { |column| argument(column.name, type_of(column)) } << ", name: " << span_name(table, "find") << ") { |row| Record.read(row) }\n"
        io << "    end\n"
      end
    end

    private def self.crud_insert(schema : Schema, table : Schema::Table, inserted : Array(Schema::Column)) : String
      # A group's columns always get its composite's values.
      values = inserted.each_with_index.join(", ") do |column, index|
        column.default && !column.group ? "coalesce(?#{index + 1}, #{column.default})" : "?#{index + 1}"
      end
      parameters = inserted.reject { |column| column.source || column.plaintext_of }.compact_map do |column|
        if group = column.group
          next unless group.columns.first == column
          next "#{group.field} : #{group.composite.name}#{group.nilable? ? "? = nil" : ""}"
        end
        type = type_of(column)
        optional = (type.nullable && !type.filled) || !column.default.nil?
        "#{column.name} : #{type.nilable(optional).crystal}#{optional ? " = nil" : ""}"
      end.join(", ")
      String.build do |io|
        heredoc(io, "INSERT", "INSERT INTO #{quote(table.name)} (#{inserted.join(", ") { |column| quote(column.name) }})\nVALUES (#{values})\nRETURNING #{column_list(table)}")
        io << '\n'
        io << "    # Columns with a default take it when given `nil`.\n" if inserted.any? { |column| column.default && !column.group }
        violations = Writes.inserted(table, inserted.map(&.name).to_set)
        io << "    def self.insert(db : Punch::Writer, *, " << parameters << ") : " << with_violations("Record", violations) << '\n'
        io << "      db.query_one?(INSERT, " << inserted.join(", ") { |column| written(schema, table, column, "") }
        io << ", name: " << span_name(table, "insert") << ") { |row| Record.read(row) } ||\n"
        io << "        raise Punch::Database::Error.new(\"INSERT INTO " << table.name << " returned no row\")\n"
        rescue_violations(io, violations)
        io << "    end\n"
      end
    end

    private def self.crud_update(schema : Schema, table : Schema::Table, key : Array(Schema::Column), updated : Array(Schema::Column)) : String
      sets = updated.each_with_index.join(",\n  ") { |column, index| "#{quote(column.name)} = ?#{key.size + index + 1}" }
      String.build do |io|
        heredoc(io, "UPDATE", "UPDATE #{quote(table.name)} SET\n  #{sets}\nWHERE #{key_condition(key)}\nRETURNING #{column_list(table)}")
        violations = Writes.updated(table, updated.map(&.name).to_set)
        io << "\n    # Writes every column of *record*; `nil` when its row is gone.\n"
        io << "    def self.update(db : Punch::Writer, record : Record) : " << "#{with_violations("Record", violations)}?" << '\n'
        io << "      db.query_one?(UPDATE, " << (key + updated).join(", ") { |column| written(schema, table, column, "record.") }
        io << ", name: " << span_name(table, "update") << ") { |row| Record.read(row) }\n"
        rescue_violations(io, violations)
        io << "    end\n"
      end
    end

    # What a `Table` write binds for *column*: a blind index hashes its
    # encrypted column, and a plaintext column being converted gets a copy
    # of the value its encrypted column holds (`from(:email)`).
    private def self.written(schema : Schema, table : Schema::Table, column : Schema::Column, prefix : String) : String
      return argument(group_access(schema, column, prefix), type_of(column)) if column.group
      # A blind index over a group's column hashes that field of the composite.
      if (source = column.source.try { |name| table.column(name) }) && source.group
        return argument(group_access(schema, source, prefix), type_of(column))
      end
      if target = column.plaintext_of
        encrypted = type_of(table.column(target) || raise "no column #{target}")
        value = encrypted.nullable ? "#{prefix}#{target}.try(&.unwrap)" : "#{prefix}#{target}.unwrap"
        return "Punch::Stored.dump(#{value})"
      end
      argument("#{prefix}#{column.source || column.name}", type_of(column))
    end

    # The value of a group's column in its composite: `address.city`, or
    # `address.try(&.city)` where the group or a field on the way is nilable.
    private def self.group_access(schema : Schema, column : Schema::Column, prefix : String) : String
      group = column.group || raise "#{column.name} is in no group"
      expression = "#{prefix}#{group.field}"
      maybe_nil = group.nilable?
      composite = group.composite
      column.member.each do |name|
        expression = maybe_nil ? "#{expression}.try(&.#{name})" : "#{expression}.#{name}"
        field = composite.try(&.field(name)) || break
        maybe_nil ||= field.type.nilable?
        composite = schema.composites[field.type.name]? if field.type.kind.composite?
      end
      expression
    end

    private def self.crud_delete(table : Schema::Table, key : Array(Schema::Column)) : String
      violations = Writes.deleted(table)
      String.build do |io|
        heredoc(io, "DELETE", "DELETE FROM #{quote(table.name)}\nWHERE #{key_condition(key)}")
        io << "\n    # Whether a row was deleted.\n"
        io << "    def self.delete(db : Punch::Writer, " << key_parameters(key) << ") : " << with_violations("Bool", violations) << '\n'
        io << "      db.exec(DELETE, " << key.join(", ") { |column| argument(column.name, type_of(column)) } << ", name: " << span_name(table, "delete") << ").changes > 0\n"
        rescue_violations(io, violations)
        io << "    end\n"
      end
    end

    # Parses every mapped column of a batch of rows for `Punch::Database::Audit`.
    private def self.crud_audit(table : Schema::Table) : String
      mapped = table.columns.select { |column| column.type.try(&.domain) }
      # A blind index is read with its encrypted column, which it must hash.
      selected = mapped.join(", ") { |column| column.source.try { |source| "#{quote(column.name)}, #{quote(source)}" } || quote(column.name) }
      # A conversion counts the values still only in plaintext, and the
      # plaintext copies left.
      converting = table.columns.select(&.type.try(&.from))
      converting.each do |column|
        plain = quote(column.type.try(&.from) || "")
        selected += ", #{quote(column.name)} IS NULL AND #{plain} IS NOT NULL, #{plain} IS NOT NULL"
      end
      String.build do |io|
        heredoc(io, "AUDIT", "SELECT rowid, #{selected}\nFROM #{quote(table.name)}\nWHERE rowid > ?1\nORDER BY rowid\nLIMIT ?2")
        io << "\n    # Parses every mapped column of up to *limit* rows after rowid *after*\n"
        io << "    # (`punch db:audit`); returns the last rowid read, `nil` when none was left.\n"
        io << "    def self.audit(db : Punch::Reader, after : Int64, limit : Int32, audit : Punch::Database::Audit) : Int64?\n"
        io << "      last = nil\n"
        io << "      db.query_each(AUDIT, after, limit.to_i64, name: " << span_name(table, "audit") << ") do |row|\n"
        io << "        rowid = last = row.read(Int64)\n"
        io << "        audit.row(" << table.name.inspect << ")\n"
        mapped.each do |column|
          type = type_of(column)
          if source = column.source
            io << "        audit.check_index(" << table.column(source).try(&.type).try(&.domain) << ", row.read(Bytes?), row.read(Bytes?), "
            io << table.name.inspect << ", " << column.name.inspect << ", " << source.inspect << ", rowid)\n"
          else
            io << "        audit.check(" << type.domain << ", row.read(" << type.nilable(true).stored_crystal << "), " << table.name.inspect << ", " << column.name.inspect << ", rowid)\n"
          end
        end
        converting.each do |column|
          io << "        audit.conversion(" << table.name.inspect << ", " << column.name.inspect << ", " << column.type.try(&.from).inspect << ", row.read(Int64) == 1, row.read(Int64) == 1)\n"
        end
        io << "      end\n"
        io << "      last\n"
        io << "    end\n"
      end
    end

    # A table is re-encrypted (`Punch::Database::Encryption`) when it has
    # an encrypted column and rows have a rowid to resume after.
    private def self.reencrypted?(table : Schema::Table) : Bool
      !table.without_rowid? && table.columns.any?(&.type.try(&.encrypted))
    end

    # Brings a batch of rows to the key ring's signing key: converts
    # plaintext that has no ciphertext yet, re-encrypts values and rehashes
    # blind indexes under older keys, and clears plaintext copies that a
    # later release drops. Writes only the rows that change.
    private def self.crud_reencrypt(table : Schema::Table) : String
      managed = table.columns.select { |column| (type = column.type) && (type.encrypted || type.blind || column.plaintext_of) }
      written = managed.reject { |column| column.plaintext_of && !column.cleared? }
      String.build do |io|
        heredoc(io, "REENCRYPT", "SELECT rowid, #{managed.join(", ") { |column| quote(column.name) }}\nFROM #{quote(table.name)}\nWHERE rowid > ?1\nORDER BY rowid\nLIMIT ?2")
        io << '\n'
        sets = written.each_with_index.join(", ") { |column, index| "#{quote(column.name)} = ?#{index + 2}" }
        heredoc(io, "REENCRYPT_WRITE", "UPDATE #{quote(table.name)} SET #{sets}\nWHERE rowid = ?1")
        io << "\n    # Converts, re-encrypts, and rehashes up to *limit* rows after rowid *after* under the\n"
        io << "    # signing key (`punch db:encrypt`); returns the last rowid read, `nil` when none was left.\n"
        io << "    def self.reencrypt(db : Punch::Writer, after : Int64, limit : Int32, run : Punch::Database::Encryption) : Int64?\n"
        io << "      rows = db.query_all(REENCRYPT, after, limit.to_i64, name: " << span_name(table, "reencrypt") << ") do |row|\n"
        io << "        {row.read(Int64), " << managed.join(", ") { |column| "row.read(#{type_of(column).nilable(true).stored_crystal})" } << "}\n"
        io << "      end\n"
        io << "      rows.each do |(rowid, " << managed.join(", ") { |column| local(column.name) } << ")|\n"
        io << "        run.row(" << table.name.inspect << ")\n"
        # Encrypted columns first: blind indexes hash their new values.
        (managed.select(&.type.try(&.encrypted)) + managed.select(&.type.try(&.blind))).each do |column|
          type = type_of(column)
          name = local(column.name)
          if source = column.source
            io << "        " << name << "_new = run.indexed(" << name << ", " << local(source) << "_new, " << table.name.inspect << ", " << column.name.inspect << ", " << source.inspect << ", rowid)\n"
          elsif from = type.from
            plain = type_of(table.column(from) || raise "no column #{from}")
            io << "        " << name << "_new = run.converted(" << plain.domain << ", " << name << ", " << local(from) << ", " << table.name.inspect << ", " << column.name.inspect << ", " << from.inspect << ", rowid)\n"
          else
            io << "        " << name << "_new = run.encrypted(" << name << ", " << table.name.inspect << ", " << column.name.inspect << ", rowid)\n"
          end
        end
        written.select(&.plaintext_of).each do |column|
          io << "        " << local(column.name) << "_new = run.cleared(" << local(column.name) << ", " << local(column.plaintext_of || "") << "_new, " << table.name.inspect << ", " << column.name.inspect << ")\n"
        end
        news = written.join(", ") { |column| "#{local(column.name)}_new" }
        olds = written.join(", ") { |column| local(column.name) }
        io << "        next if {" << news << "} == {" << olds << "}\n\n"
        io << "        run.write(" << table.name.inspect << ", rowid) { db.exec(REENCRYPT_WRITE, rowid, " << news << ", name: " << span_name(table, "reencrypt") << ") }\n"
        io << "      end\n"
        io << "      rows.last?.try(&.[0])\n"
        io << "    end\n"
      end
    end

    # The columns of *table* that hold a composite as a JSON document,
    # plain or encrypted, with the composite.
    private def self.documents(schema : Schema, table : Schema::Table) : Array({Schema::Column, String})
      table.record_columns.compact_map do |column|
        domain = column.type.try(&.domain) || next
        name = domain.lchop("Punch::Encrypted(").rchop(")")
        {column, name} if schema.composites.has_key?(name) && !column.generated?
      end
    end

    # Rewrites the documents of a batch of rows in their composite's
    # current version (`Punch::Database::Upgrade`): older versions, and
    # documents not in their stored form. Writes only the rows that change.
    private def self.crud_upgrade(table : Schema::Table, documents : Array({Schema::Column, String})) : String
      columns = documents.map(&.[0])
      String.build do |io|
        heredoc(io, "UPGRADE", "SELECT rowid, #{columns.join(", ") { |column| quote(column.name) }}\nFROM #{quote(table.name)}\nWHERE rowid > ?1\nORDER BY rowid\nLIMIT ?2")
        io << '\n'
        sets = columns.each_with_index.join(", ") { |column, index| "#{quote(column.name)} = ?#{index + 2}" }
        heredoc(io, "UPGRADE_WRITE", "UPDATE #{quote(table.name)} SET #{sets}\nWHERE rowid = ?1")
        io << "\n    # Rewrites the documents of up to *limit* rows after rowid *after* in their current version\n"
        io << "    # (`punch db:upgrade`); returns the last rowid read, `nil` when none was left.\n"
        io << "    def self.upgrade(db : Punch::Writer, after : Int64, limit : Int32, run : Punch::Database::Upgrade) : Int64?\n"
        io << "      rows = db.query_all(UPGRADE, after, limit.to_i64, name: " << span_name(table, "upgrade") << ") do |row|\n"
        io << "        {row.read(Int64), " << columns.join(", ") { |column| "row.read(#{type_of(column).nilable(true).stored_crystal})" } << "}\n"
        io << "      end\n"
        io << "      rows.each do |(rowid, " << columns.join(", ") { |column| local(column.name) } << ")|\n"
        io << "        run.row(" << table.name.inspect << ")\n"
        documents.each do |column, composite|
          method = type_of(column).encrypted ? "encrypted_document" : "document"
          io << "        " << local(column.name) << "_new = run." << method << "(" << composite << ", " << local(column.name) << ", " << table.name.inspect << ", " << column.name.inspect << ", rowid)\n"
        end
        news = columns.join(", ") { |column| "#{local(column.name)}_new" }
        olds = columns.join(", ") { |column| local(column.name) }
        io << "        next if {" << news << "} == {" << olds << "}\n\n"
        io << "        run.write(" << table.name.inspect << ", rowid) { db.exec(UPGRADE_WRITE, rowid, " << news << ", name: " << span_name(table, "upgrade") << ") }\n"
        io << "      end\n"
        io << "      rows.last?.try(&.[0])\n"
        io << "    end\n"
      end
    end

    # The span name of a generated method, as a string literal.
    private def self.span_name(table : Schema::Table, method : String) : String
      "#{table.mod}::Table.#{method}".inspect
    end

    private def self.column_list(table : Schema::Table) : String
      table.record_columns.join(", ") { |column| quote(column.name) }
    end

    private def self.key_condition(key : Array(Schema::Column)) : String
      key.each_with_index.join(" AND ") { |column, index| "#{quote(column.name)} = ?#{index + 1}" }
    end

    # Mapped tables have a type for every column (checked before emitting).
    private def self.type_of(column : Schema::Column) : Type
      column.type || raise "#{column.name} has no type"
    end

    private def self.key_parameters(key : Array(Schema::Column)) : String
      text = key.join(", ") { |column| "#{column.name} : #{type_of(column).nilable(false).crystal}" }
      key.size > 1 ? "*, #{text}" : text
    end

    # One file of named queries.
    def self.queries(mod : String, analyses : Array(Analysis), schema : Schema, source : String) : String
      String.build do |io|
        header(io, source)
        io << "module " << mod << '\n'
        analyses.each_with_index do |analysis, index|
          io << '\n' if index > 0
          named_query(io, mod, analysis, schema, source)
        end
        io << "end\n"
      end
    end

    # `Row?`, `Array(Row)`, `Nil`, or `Int64`, with the violations:
    # `Row | EmailTaken?` (nilable, as Ameba's Style/VerboseNilType wants).
    private def self.result_type(kind : Kind, row : String, violations : Array(Schema::Unique), prefix : String, type_name : String) : String
      result = case kind
               in .one?       then row
               in .many?      then "Array(#{row})"
               in .page?      then "Punch::Paged(#{row}, #{type_name}::Cursor)"
               in .exec?      then "Nil"
               in .exec_rows? then "Int64"
               end
      return with_violations("", violations, prefix).lchop(" | ") + "?" if kind.exec? && !violations.empty?
      result = with_violations(result, violations, prefix)
      kind.one? ? "#{result}?" : result
    end

    private def self.named_query(io : IO, mod : String, analysis : Analysis, schema : Schema, source : String) : Nil
      query = analysis.query
      type_name = query.name
      record_table = analysis.record
      returns_rows = query.kind.one? || query.kind.many? || query.kind.page?
      row = record_table ? "#{record_table.mod}::Record" : "#{type_name}::Row"
      filtered = analysis.filtered
      io << "  # " << File.basename(source) << ':' << query.location.line << '\n'
      io << "  module " << type_name << '\n'
      if filtered
        clause_types(io, query, filtered)
      else
        heredoc(io, "SQL", analysis.positional_sql)
      end
      if returns_rows && !record_table
        io << '\n'
        row_struct(io, schema, "Row", analysis.columns, query.name, rowids(schema, analysis.columns), query.includes.map(&.[0]))
      end
      filtered.try(&.keyset).try { |keyset| cursor_struct(io, query, keyset, row) }
      io << "  end\n\n"

      query.doc.each { |line| io << "  #" << (line.empty? ? "" : " #{line}") << '\n' }
      handle = analysis.read_only? ? "Punch::Reader | Punch::Writer" : "Punch::Writer"
      parameters = method_parameters(analysis)
      violations = analysis.violations
      prefix = analysis.target.try { |table| "#{table.mod}::" } || ""
      result = result_type(query.kind, row, violations, prefix, type_name)
      result = with_invalid(result, analysis)
      io << "  def self." << query.method_name << "(db : " << handle << (parameters.empty? ? "" : ", *, #{parameters.join(", ")}") << ") : " << result << '\n'
      array_guards(io, analysis)
      name = "name: #{"#{mod}.#{query.method_name}".inspect}"
      if filtered
        assembly(io, analysis, filtered)
        call = "(sql, args: args, #{name})"
      else
        call = "(" + (["#{type_name}::SQL"] + analysis.params.map { |param| argument(param.name, param.type) } + [name]).join(", ") + ")"
      end
      run(io, query.kind, call, row, type_name, !!filtered.try(&.orders.present?))
      rescue_violations(io, violations, prefix)
      io << "  end\n"
      by_key_method(io, mod, analysis, handle, row)
    end

    # *result* with `Punch::Invalid` when the query has an array parameter:
    # it returns `too_many` for more than `Punch::Stored::ARRAY_MAX` elements.
    private def self.with_invalid(result : String, analysis : Analysis) : String
      return result unless analysis.params.any?(&.type.array)
      return "Punch::Invalid?" if result == "Nil"

      result.ends_with?('?') ? "#{result.rchop('?')} | Punch::Invalid?" : "#{result} | Punch::Invalid"
    end

    # Returns `too_many` before the query runs for an array parameter with
    # more than `Punch::Stored::ARRAY_MAX` elements.
    private def self.array_guards(io : IO, analysis : Analysis) : Nil
      analysis.params.select(&.type.array).each do |param|
        io << "    return Punch::Invalid.new(\"too_many\", max: Punch::Stored::ARRAY_MAX) if " << param.name << ".size > Punch::Stored::ARRAY_MAX\n"
      end
    end

    # The by-key variant of a `:page` query: the one row with a given key,
    # if it is in the page's rows for these parameters and *filter*, from
    # the same statement and clauses (written once, so a row cannot be in
    # the list and out of the check, or the other way round).
    private def self.by_key_method(io : IO, mod : String, analysis : Analysis, handle : String, row : String) : Nil
      filtered = analysis.filtered
      keyset = filtered.try(&.keyset)
      return unless filtered && keyset
      query = analysis.query
      type_name = query.name
      parameters = analysis.params.reject { |param| filtered.fields.any?(&.param.==(param)) }.map { |param| "#{param.name} : #{param.type.crystal}" }
      parameters << "key : #{keyset.row_key.column.type.nilable(false).crystal}"
      parameters << "filter : #{type_name}::Filter = #{type_name}::Filter.new" unless filtered.fields.empty?
      method = "#{query.method_name}_by_key"
      io << '\n'
      io << "  # The row of `" << query.method_name << "` whose `" << keyset.row_key.column.name << "` is *key*, or `nil` when `" << query.method_name << "` would not list it\n"
      io << "  # for these parameters and *filter*: the same statement and clauses, never a copy of them.\n"
      io << "  def self." << method << "(db : " << handle << ", *, " << parameters.join(", ") << ") : " << row << "?\n"
      assembly(io, analysis, filtered, by_key: true)
      run(io, Kind::One, "(sql, args: args, name: #{"#{mod}.#{method}".inspect})", row, type_name, false)
      io << "  end\n"
    end

    # The statement's run and the method's result; *ordered* when a page's
    # cursor takes an order and direction.
    private def self.run(io : IO, kind : Kind, call : String, row : String, type_name : String, ordered : Bool) : Nil
      case kind
      in .one?  then io << "    db.query_one?" << call << " { |row| " << row << ".read(row) }\n"
      in .many? then io << "    db.query_all" << call << " { |row| " << row << ".read(row) }\n"
      in .page?
        io << "    rows = db.query_all" << call << " { |row| " << row << ".read(row) }\n"
        io << "    Punch::Paged(" << row << ", " << type_name << "::Cursor).new(rows, limit) { |last| "
        io << type_name << "::Cursor.after(last" << (ordered ? ", order, direction" : "") << ") }\n"
      in .exec?      then io << "    db.exec" << call << "\n    nil\n"
      in .exec_rows? then io << "    db.exec" << call << ".changes\n"
      end
    end

    # The keyword parameters of a query's method: its parameters, or for a
    # query with declared clauses those outside the clauses, its filter, and
    # its order.
    private def self.method_parameters(analysis : Analysis) : Array(String)
      filtered = analysis.filtered
      type_name = analysis.query.name
      params = analysis.params.reject { |param| filtered.try(&.fields.any?(&.param.==(param))) }
      parameters = params.map { |param| "#{param.name} : #{param.type.crystal}" }
      return parameters unless filtered
      parameters << "filter : #{type_name}::Filter = #{type_name}::Filter.new" unless filtered.fields.empty?
      filtered.orders.first?.try do |order|
        parameters << "order : #{type_name}::Order = #{type_name}::Order::#{QueryGen.camelcase(order.key)}"
        parameters << "direction : Punch::Database::Direction = Punch::Database::Direction::Asc"
      end
      if filtered.keyset
        parameters << "after : #{type_name}::Cursor? = nil"
        parameters << "limit : Int32 | Punch::PageSize"
      end
      parameters
    end

    # The constant of a piece of a statement with declared clauses.
    private def self.piece_constant(piece : Filtered::Piece, index : Int32) : String
      clause = piece.clause || return "SQL_#{index}"
      "#{clause.kind.to_s.upcase}_#{clause.key.upcase}#{clause.member.try { |member| "_#{member.upcase}" }}"
    end

    # The statement's pieces, `Filter`, and `Order` of a query with
    # declared clauses.
    private def self.clause_types(io : IO, query : Query, filtered : Filtered) : Nil
      io << "    # The statement in pieces: the method joins the fixed ones (SQL_n) with\n"
      io << "    # the clauses its filter and order choose.\n"
      fixed = 0
      filtered.pieces.each do |piece|
        if piece.after
          filtered.keyset.try do |keyset|
            keyset.keys.each { |key| io << "    " << after_constant(key) << " = " << key.sql.inspect << '\n' }
            io << "    BY_KEY = " << keyset.by_key_sql.inspect << '\n'
          end
          next
        end
        fixed += 1 unless piece.clause
        constant = piece_constant(piece, fixed)
        if clause = piece.clause
          io << "    " << constant << " = " << piece.sql.inspect << '\n'
          io << "    " << constant << "_DESC = " << SQL.reverse_order(piece.sql).inspect << '\n' if clause.kind.order?
        else
          heredoc(io, constant, piece.sql)
        end
      end
      unless filtered.fields.empty?
        filter_struct(io, query, filtered)
      end
      return if filtered.orders.empty?
      io << "\n    # How `" << query.method_name << "` sorts; " << QueryGen.camelcase(filtered.orders.first.key) << " unless told otherwise.\n"
      io << "    enum Order\n"
      filtered.orders.each { |order| io << "      " << QueryGen.camelcase(order.key) << '\n' }
      io << "    end\n"
    end

    private def self.filter_struct(io : IO, query : Query, filtered : Filtered) : Nil
      io << "\n    # What narrows `" << query.method_name << "`: each clause applies when its field is set.\n"
      io << "    struct Filter\n      include Punch::Input\n\n"
      filtered.fields.each do |field|
        toggle = toggle?(field)
        io << "      getter" << (toggle ? "? " : " ") << field.key << " : " << field_type(field) << (toggle ? " = false" : "") << '\n'
      end
      io << "\n      def initialize(*"
      filtered.fields.each { |field| io << ", @" << field.key << " : " << field_type(field) << " = " << (toggle?(field) ? "false" : "nil") }
      io << ")\n      end\n    end\n"
    end

    private def self.field_type(field : Filtered::Field) : String
      field.type
    end

    # A clause without a parameter or members: a `Bool` turns it on.
    private def self.toggle?(field : Filtered::Field) : Bool
      field.param.nil? && field.enum_type.nil?
    end

    # The body that joins the pieces and collects their arguments.
    private def self.assembly(io : IO, analysis : Analysis, filtered : Filtered, by_key : Bool = false) : Nil
      type_name = analysis.query.name
      types = analysis.params.to_h { |param| {param.name, param.type} }
      keyset = filtered.keyset
      cursor_order(io, filtered, by_key)
      io << "    args = [] of Punch::Database::Value\n"
      io << "    sql = String.build do |io|\n"
      fixed = 0
      # The orders and each enum field are written once, at their first piece.
      done = Set(String).new
      filtered.pieces.each do |piece|
        if piece.after && keyset
          after_piece(io, type_name, keyset, by_key)
          next
        end
        fixed += 1 unless piece.clause
        constant = "#{type_name}::#{piece_constant(piece, fixed)}"
        clause = piece.clause
        if clause.nil?
          io << "      io << " << constant << " << '\\n'\n"
          bind(io, piece, types, "      ")
        elsif clause.kind.order?
          order_case(io, type_name, filtered, by_key) if done.add?("-- order")
        elsif clause.member
          member_case(io, type_name, filtered.fields.find!(&.key.==(clause.key))) if done.add?(clause.key)
        else
          when_piece(io, constant, clause, piece, types)
        end
      end
      limit(io) if keyset && !by_key
      io << "    end\n"
    end

    # A page takes its order from the cursor it continues; by key has none.
    private def self.cursor_order(io : IO, filtered : Filtered, by_key : Bool) : Nil
      return if by_key || filtered.keyset.nil? || filtered.orders.empty?
      io << "    order, direction = after.order, after.direction if after\n"
    end

    private def self.limit(io : IO) : Nil
      io << "      io << \"LIMIT ?\"\n"
      io << "      args << Punch::Paged.fetch(limit)\n"
    end

    # Where a page's cursor condition goes: that, or the by-key condition.
    private def self.after_piece(io : IO, type_name : String, keyset : Keyset, by_key : Bool) : Nil
      return seek(io, type_name, keyset) unless by_key
      io << "      io << " << type_name << "::BY_KEY << '\\n'\n"
      io << "      args << " << argument("key", keyset.row_key.column.type) << '\n'
    end

    # A `when` clause of its own field: on when its toggle is true or its
    # field set, binding the field's value.
    private def self.when_piece(io : IO, constant : String, clause : Clause, piece : Filtered::Piece, types : Hash(String, Type)) : Nil
      if piece.params.empty?
        io << "      io << " << constant << " << '\\n' if filter." << clause.key << "?\n"
      else
        io << "      filter." << clause.key << ".try do |value|\n"
        io << "        io << " << constant << " << '\\n'\n"
        bind(io, piece, types, "        ")
        io << "      end\n"
      end
    end

    # The order chosen, as written or read backwards.
    private def self.order_case(io : IO, type_name : String, filtered : Filtered, by_key : Bool) : Nil
      return if by_key # one row needs no order
      io << "      case order\n"
      filtered.orders.each do |order|
        constant = "#{type_name}::ORDER_#{order.key.upcase}"
        io << "      in ." << order.key << "? then io << (direction.desc? ? " << constant << "_DESC : " << constant << ") << '\\n'\n"
      end
      io << "      end\n"
    end

    # An enum field's clauses: a `case … in` over the enum, so the compiler
    # reports a member without a clause, or a clause for no member.
    private def self.member_case(io : IO, type_name : String, field : Filtered::Field) : Nil
      location = field.clause.location
      io << "      # One clause per member of " << field.enum_type << " (" << location.file << ":" << location.line << ").\n"
      io << "      filter." << field.key << ".try do |value|\n"
      io << "        case value\n"
      field.members.each do |member|
        io << "        in ." << member.member << "? then io << " << type_name << "::" << piece_constant(Filtered::Piece.new(member, "", [] of String), 0) << " << '\\n'\n"
      end
      io << "        end\n"
      io << "      end\n"
    end

    # `AFTER`, or `AFTER_NEWEST` for an order: the condition that continues
    # after a cursor.
    private def self.after_constant(key : Keyset::Key) : String
      key.order.try { |order| "AFTER_#{order.key.upcase}#{order.reversed? ? "_DESC" : ""}" } || "AFTER"
    end

    # Appends the condition after the cursor and binds its values.
    private def self.seek(io : IO, type_name : String, keyset : Keyset) : Nil
      io << "      after.try do |cursor|\n"
      if keyset.keys.size == 1 && keyset.keys.first.order.nil?
        seek_key(io, type_name, keyset.keys.first, "        ")
      else
        io << "        case cursor.order\n"
        keyset.keys.reject(&.reversed?).each do |key|
          io << "        in ." << key.order.try(&.key) << "?\n"
          seek_key(io, type_name, key, "          ")
        end
        io << "        end\n"
      end
      io << "      end\n"
    end

    private def self.seek_key(io : IO, type_name : String, key : Keyset::Key, indent : String) : Nil
      constant = "#{type_name}::#{after_constant(key)}"
      if key.order
        io << indent << "io << (cursor.direction.desc? ? " << constant << "_DESC : " << constant << ") << '\\n'\n"
      else
        io << indent << "io << " << constant << " << '\\n'\n"
      end
      if key.indexes == (0...key.terms.size).to_a
        io << indent << "args.concat(cursor.values)\n"
      else
        io << indent << key.indexes.inspect.sub('[', '{').sub(']', '}') << ".each { |index| args << cursor.values[index] }\n"
      end
    end

    # `Paged::Cursor`: where the next page of a `:page` query starts, as a token
    # for a query string.
    private def self.cursor_struct(io : IO, query : Query, keyset : Keyset, row : String) : Nil
      ordered = keyset.keys.first.order
      io << "\n    # Where a page of `" << query.method_name << "` continues: the sort values of the row\n"
      io << "    # before it" << (ordered ? " and the order they belong to" : "") << ", as a token for a query string.\n"
      io << "    struct Cursor\n      include Punch::Primitive(String)\n\n"
      io << "      LAYOUTS = {\n"
      keyset.keys.reject(&.reversed?).each do |key|
        kinds = key.terms.join(", ") { |term| "Punch::Paged::Cursor::Kind::#{cursor_kind(term.column.type)}" }
        io << "        " << (key.order.try(&.key) || "").inspect << " => [" << kinds << "],\n"
      end
      io << "      }\n\n"
      io << "      # The order it continues, and which way.\n      getter order : Order\n      getter direction : Punch::Database::Direction\n" if ordered
      io << "      # The sort values, as stored.\n      getter values : Array(Punch::Database::Value)\n\n"
      io << "      private def initialize(@value : String, " << (ordered ? "@order : Order, @direction : Punch::Database::Direction, " : "") << "@values : Array(Punch::Database::Value))\n      end\n\n"
      io << "      def self.json_schema\n        Punch::Paged::Cursor.json_schema\n      end\n\n"
      domains = keyset.keys.flat_map(&.terms).compact_map(&.column.type.domain).uniq!
      sealed = domains.empty? ? "" : ", sealed: sealed?"
      unless domains.empty?
        io << "      # Sealed when a sort value is a public ID (`Punch::Paged::Cursor`).\n"
        io << "      def self.sealed? : Bool\n        Punch::Paged::Cursor.sealed?(" << domains.join(", ") { |domain| "::#{domain.lchop("::")}" } << ")\n      end\n\n"
      end
      io << "      def self.parse(raw : String) : self | Punch::Invalid\n"
      io << "        " << (ordered ? "key, direction" : "_, _") << ", values = Punch::Paged::Cursor.decode(raw, LAYOUTS" << sealed << ") || return Punch::Paged::Cursor.invalid\n"
      io << "        new(raw, " << (ordered ? "Order.parse(key), direction, " : "") << "values)\n      end\n\n"
      io << "      # The cursor after *row*" << (ordered ? " in *order* and *direction*" : "") << ".\n"
      io << "      def self.after(row : " << row << (ordered ? ", order : Order, direction : Punch::Database::Direction" : "") << ") : self\n"
      if ordered
        io << "        values = case order\n"
        keyset.keys.reject(&.reversed?).each do |key|
          io << "                 in ." << key.order.try(&.key) << "? then " << cursor_values(key) << '\n'
        end
        io << "                 end\n"
        io << "        new(Punch::Paged::Cursor.encode(order.to_s.underscore, values, direction" << sealed << "), order, direction, values)\n"
      else
        io << "        values = " << cursor_values(keyset.keys.first) << '\n'
        io << "        new(Punch::Paged::Cursor.encode(nil, values" << sealed << "), values)\n"
      end
      io << "      end\n    end\n"
    end

    private def self.cursor_values(key : Keyset::Key) : String
      "[" + key.terms.join(", ") { |term| argument("row.#{term.column.name}", term.column.type) } + "] of Punch::Database::Value"
    end

    private def self.cursor_kind(type : Type) : String
      case type.stored
      when "Int64"   then "Integer"
      when "Float64" then "Real"
      else                "Text"
      end
    end

    # Collects the arguments of *piece*; a clause's parameter is the block's
    # `value`.
    private def self.bind(io : IO, piece : Filtered::Piece, types : Hash(String, Type), indent : String) : Nil
      piece.params.each { |name| io << indent << "args << " << argument(piece.clause ? "value" : name, types[name]) << '\n' }
    end
  end
end
