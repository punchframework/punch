        Punch::Composite.read(object, "filename", Punch::Secret(Punch::Upload::Filename), path),
        Punch::Composite.read(object, "size", Int64, path),
        Punch::Composite.read(object, "content_type", String, path),
        Punch::Composite.read(object, "scan_state", Punch::Upload::ScanState?, path),
        Punch::Composite.read(object, "delete_after", Time?, path),
        Punch::Composite.read(object, "width", Int64?, path),
        Punch::Composite.read(object, "height", Int64?, path),
        Punch::Composite.read(object, "alt", Punch::Secret(Punch::NonEmptyString)?, path),
        Punch::Composite.unknown(object, {"key", "filename", "size", "content_type", "scan_state", "delete_after", "width", "height", "alt"}),
      ), path)
    end

    # :nodoc:
    def self.punch_group(key : Punch::Upload::Key, filename : Punch::Secret(Punch::Upload::Filename), size : Int64, content_type : String, scan_state : Punch::Upload::ScanState?, delete_after : Time?, width : Int64?, height : Int64?, alt : Punch::Secret(Punch::NonEmptyString)?, table : String, prefix : String, row_id : Int64?) : self
      Punch::Composite.grouped(new(key, filename, size, content_type, scan_state, delete_after, width, height, alt), table, prefix, row_id)
    end

    # :nodoc:
    def self.punch_schema(registry : Punch::JSONSchema::Registry) : JSON::Any
      registry.define("Punch::Upload::PrivateImageFile") do
        properties = {} of String => JSON::Any
        required = [] of String
        properties["key"] = registry.schema(Punch::Upload::Key)
        required << "key"
        properties["filename"] = registry.schema(Punch::Secret(Punch::Upload::Filename))
        required << "filename"
        properties["size"] = registry.schema(Int64)
        required << "size"
        properties["content_type"] = registry.schema(String)
        required << "content_type"
        properties["scan_state"] = registry.schema(Punch::Upload::ScanState?)
        properties["delete_after"] = registry.schema(Time?)
        properties["width"] = registry.schema(Int64?)
        properties["height"] = registry.schema(Int64?)
        properties["alt"] = registry.schema(Punch::Secret(Punch::NonEmptyString)?)
        Punch::JSONSchema.composite(properties, required)
      end
    end
  end
