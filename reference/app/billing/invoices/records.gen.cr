      RETURNING id, organization_id, customer_id, currency, status, number, sent_at, due_at, created_at, billed_to
      SQL

    def self.insert(db : Punch::Writer, *, organization_id : Accounts::Organizations::ID, customer_id : Billing::Customers::ID, currency : Punch::Currency, status : String, number : Billing::Invoices::Number? = nil, sent_at : Time? = nil, due_at : Time? = nil, created_at : Time, billed_to : Punch::Secret(Billing::Invoices::BilledTo)? = nil) : Record | NumberTaken
      db.query_one?(INSERT, Punch::Stored.dump(organization_id), Punch::Stored.dump(customer_id), Punch::Stored.dump(currency), status, Punch::Stored.dump(number), Punch::Stored.dump(sent_at), Punch::Stored.dump(due_at), Punch::Stored.dump(created_at), Punch::Stored.encrypt(billed_to, "invoices", "billed_to"), name: "Billing::Invoices::Table.insert") { |row| Record.read(row) } ||
        raise Punch::Database::Error.new("INSERT INTO invoices returned no row")
    rescue ex : Punch::Database::ConstraintError
      case ex.detail
      when NumberTaken::MESSAGE then NumberTaken.new
      else                           raise ex
      end
    end

    UPDATE = <<-SQL
      UPDATE invoices SET
        organization_id = ?2,
        customer_id = ?3,
        currency = ?4,
        status = ?5,
        number = ?6,
        sent_at = ?7,
        due_at = ?8,
        created_at = ?9,
        billed_to = ?10
      WHERE id = ?1
      RETURNING id, organization_id, customer_id, currency, status, number, sent_at, due_at, created_at, billed_to
      SQL

    # Writes every column of *record*; `nil` when its row is gone.
    def self.update(db : Punch::Writer, record : Record) : Record | NumberTaken?
      db.query_one?(UPDATE, Punch::Stored.dump(record.id), Punch::Stored.dump(record.organization_id), Punch::Stored.dump(record.customer_id), Punch::Stored.dump(record.currency), record.status, Punch::Stored.dump(record.number), Punch::Stored.dump(record.sent_at), Punch::Stored.dump(record.due_at), Punch::Stored.dump(record.created_at), Punch::Stored.encrypt(record.billed_to, "invoices", "billed_to"), name: "Billing::Invoices::Table.update") { |row| Record.read(row) }
    rescue ex : Punch::Database::ConstraintError
      case ex.detail
      when NumberTaken::MESSAGE then NumberTaken.new
      else                           raise ex
      end
    end

    DELETE = <<-SQL
      DELETE FROM invoices
      WHERE id = ?1
      SQL

    # Whether a row was deleted.
    def self.delete(db : Punch::Writer, id : Billing::Invoices::ID) : Bool
      db.exec(DELETE, Punch::Stored.dump(id), name: "Billing::Invoices::Table.delete").changes > 0
    end

    AUDIT = <<-SQL
      SELECT rowid, id, organization_id, customer_id, currency, number, sent_at, due_at, created_at, billed_to
      FROM invoices
      WHERE rowid > ?1
      ORDER BY rowid
      LIMIT ?2
      SQL

    # Parses every mapped column of up to *limit* rows after rowid *after*
    # (`punch db:audit`); returns the last rowid read, `nil` when none was left.
    def self.audit(db : Punch::Reader, after : Int64, limit : Int32, audit : Punch::Database::Audit) : Int64?
      last = nil
      db.query_each(AUDIT, after, limit.to_i64, name: "Billing::Invoices::Table.audit") do |row|
        rowid = last = row.read(Int64)
        audit.row("invoices")
        audit.check(Billing::Invoices::ID, row.read(Int64?), "invoices", "id", rowid)
        audit.check(Accounts::Organizations::ID, row.read(Int64?), "invoices", "organization_id", rowid)
        audit.check(Billing::Customers::ID, row.read(Int64?), "invoices", "customer_id", rowid)
        audit.check(Punch::Currency, row.read(String?), "invoices", "currency", rowid)
        audit.check(Billing::Invoices::Number, row.read(String?), "invoices", "number", rowid)
        audit.check(Time, row.read(String?), "invoices", "sent_at", rowid)
        audit.check(Time, row.read(String?), "invoices", "due_at", rowid)
        audit.check(Time, row.read(String?), "invoices", "created_at", rowid)
        audit.check(Punch::Encrypted(Billing::Invoices::BilledTo), row.read(Bytes?), "invoices", "billed_to", rowid)
      end
      last
    end

    REENCRYPT = <<-SQL
      SELECT rowid, billed_to
      FROM invoices
      WHERE rowid > ?1
      ORDER BY rowid
      LIMIT ?2
      SQL

    REENCRYPT_WRITE = <<-SQL
      UPDATE invoices SET billed_to = ?2
      WHERE rowid = ?1
      SQL

    # Converts, re-encrypts, and rehashes up to *limit* rows after rowid *after* under the
    # signing key (`punch db:encrypt`); returns the last rowid read, `nil` when none was left.
    def self.reencrypt(db : Punch::Writer, after : Int64, limit : Int32, run : Punch::Database::Encryption) : Int64?
      rows = db.query_all(REENCRYPT, after, limit.to_i64, name: "Billing::Invoices::Table.reencrypt") do |row|
        {row.read(Int64), row.read(Bytes?)}
      end
      rows.each do |(rowid, billed_to)|
        run.row("invoices")
        billed_to_new = run.encrypted(billed_to, "invoices", "billed_to", rowid)
        next if {billed_to_new} == {billed_to}

        run.write("invoices", rowid) { db.exec(REENCRYPT_WRITE, rowid, billed_to_new, name: "Billing::Invoices::Table.reencrypt") }
      end
      rows.last?.try(&.[0])
    end

    UPGRADE = <<-SQL
      SELECT rowid, billed_to
      FROM invoices
      WHERE rowid > ?1
      ORDER BY rowid
      LIMIT ?2
      SQL

    UPGRADE_WRITE = <<-SQL
      UPDATE invoices SET billed_to = ?2
      WHERE rowid = ?1
      SQL

    # Rewrites the documents of up to *limit* rows after rowid *after* in their current version
    # (`punch db:upgrade`); returns the last rowid read, `nil` when none was left.
    def self.upgrade(db : Punch::Writer, after : Int64, limit : Int32, run : Punch::Database::Upgrade) : Int64?
      rows = db.query_all(UPGRADE, after, limit.to_i64, name: "Billing::Invoices::Table.upgrade") do |row|
        {row.read(Int64), row.read(Bytes?)}
      end
      rows.each do |(rowid, billed_to)|
        run.row("invoices")
        billed_to_new = run.encrypted_document(Billing::Invoices::BilledTo, billed_to, "invoices", "billed_to", rowid)
        next if {billed_to_new} == {billed_to}

        run.write("invoices", rowid) { db.exec(UPGRADE_WRITE, rowid, billed_to_new, name: "Billing::Invoices::Table.upgrade") }
      end
      rows.last?.try(&.[0])
    end
  end
end

# Every mapped column is parsed by `punch db:audit` and the nightly audit job.
Punch::Database::Audit.table("invoice_lines") { |db, after, limit, audit| Billing::Invoices::Lines::Table.audit(db, after, limit, audit) }
Punch::Database::Audit.table("invoice_payments") { |db, after, limit, audit| Billing::Invoices::Payments::Table.audit(db, after, limit, audit) }
Punch::Database::Audit.table("invoice_reminders") { |db, after, limit, audit| Billing::Invoices::Reminders::Table.audit(db, after, limit, audit) }
Punch::Database::Audit.table("invoices") { |db, after, limit, audit| Billing::Invoices::Table.audit(db, after, limit, audit) }

# Encrypted columns are brought to the signing key by `punch db:encrypt` and the nightly job.
Punch::Database::Encryption.table("invoices") { |db, after, limit, run| Billing::Invoices::Table.reencrypt(db, after, limit, run) }

# Documents are rewritten in their composite's current version by `punch db:upgrade` and the nightly job.
Punch::Database::Upgrade.table("invoices") { |db, after, limit, run| Billing::Invoices::Table.upgrade(db, after, limit, run) }
