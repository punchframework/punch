  "documents": {
    "Billing::Invoices::BilledTo": {
      "version": 1,
      "schema": {
        "$ref": "#/$defs/Billing.Invoices.BilledTo",
        "$defs": {
          "Billing.Invoices.BilledTo": {
            "type": "object",
            "properties": {
              "customer_id": {
                "type": "integer",
                "format": "int64",
                "minimum": 1
              },
              "name": {
                "type": "string",
                "pattern": "\\S"
              },
              "company_name": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "\\S"
              },
              "address": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "\\S"
              },
              "tax_id": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^ *[A-Za-z] *[A-Za-z]( *[A-Za-z0-9]){2,13} *$"
              }
            },
            "required": [
              "customer_id",
              "name"
            ]
          }
        }
      }
    }
