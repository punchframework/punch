# Errors outside the routing and authorization macros that are still
# reported inside Punch's own macros (input, SQL, views, payloads), not at
# the user's code.
LOCATION_IN_PUNCH = %w[input_optional_path_param sql_argument_type payload_strict agent_page_html_view]

describe "compile errors" do
  it "lists every file in spec/fail" do
    files = Dir.children("#{__DIR__}/../fail").select(&.ends_with?(".cr")).map(&.rchop(".cr")).sort!
    files.should eq(COMPILE_ERRORS.keys.sort!)
  end

  # The compiler runs once per file, four at a time: each needs several
  # hundred megabytes, and all at once ran a 7 GB machine out of memory.
  outputs = {} of String => Channel(String)
  slots = Channel(Nil).new(4)
  COMPILE_ERRORS.each_key do |name|
    channel = outputs[name] = Channel(String).new(1)
    spawn do
      slots.send(nil)
      output = IO::Memory.new
      # In Punch's root, not the process's directory: examples that build
      # fixture apps change it to a directory they delete.
      status = Process.run("crystal", ["build", "--no-codegen", "--no-color", "#{__DIR__}/../fail/#{name}.cr"],
        output: output, error: output, chdir: File.expand_path("../..", __DIR__))
      slots.receive
      channel.send(status.success? ? "" : output.to_s)
    end
  end

  COMPILE_ERRORS.each do |name, message|
    it "rejects #{name}" do
      output = outputs[name].receive
      output.should contain(message)
      # The error is reported in the user's file, not in Punch's macros or
      # the route table (docs/operations.md, "Where errors are reported").
      location = output.lines.find { |line| line.starts_with?("In ") || line.starts_with?("Code in ") }
      (location || "no location").should contain("fail/#{name}.cr") unless LOCATION_IN_PUNCH.includes?(name)
    end
  end
end
