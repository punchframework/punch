        Punch::Composite.read(object, "booked_at", Time?, path),
        Punch::Composite.unknown(object, {"iban", "reference", "booked_at", "kind"}),
      ), path)
    end

    # :nodoc:
    def self.punch_schema(registry : Punch::JSONSchema::Registry) : JSON::Any
      registry.define("Ledger::Transfer") do
        properties = {} of String => JSON::Any
        required = [] of String
        properties["kind"] = Punch::JSONSchema.object({"type" => JSON::Any.new("string"), "const" => JSON::Any.new("transfer")})
        required << "kind"
        properties["iban"] = registry.schema(Punch::NonEmptyString)
        required << "iban"
        properties["reference"] = registry.schema(String?)
        properties["booked_at"] = registry.schema(Time?)
        Punch::JSONSchema.composite(properties, required)
      end
    end
  end
end

# Each default parses once at program start, so one that does not fails every run at once.
Ledger::Address::PUNCH_DEFAULT_COUNTRY
