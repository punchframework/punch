# Encrypted columns are brought to the signing key by `punch db:encrypt` and the nightly job.
Punch::Database::Encryption.table("contacts") { |db, after, limit, run| Ledger::Contacts::Table.reencrypt(db, after, limit, run) }
Punch::Database::Encryption.table("leads") { |db, after, limit, run| Ledger::Leads::Table.reencrypt(db, after, limit, run) }
Punch::Database::Encryption.table("prospects") { |db, after, limit, run| Ledger::Prospects::Table.reencrypt(db, after, limit, run) }
