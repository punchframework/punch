require "../../spec_helper"

private def stored_locale : String?
  Punch::Spec.db.read(&.query_one?("SELECT locale FROM users", &.read(String?)))
end

<%- if app.languages.includes?("de") -%>
describe "the interface's language" do
  it "changes on the account page, and follows the browser again without a choice" do
    client = AccountsSpec.client
    client.language = "en"
    account = client.visit(Accounts::Sessions::IndexPage.href)
    account.should have_element("select[name=locale] option[value=de]", text: "Deutsch")

    client.submit(Accounts::Language::Update.action, form: {"locale" => "de"}).should redirect_to(Accounts::Sessions::IndexPage.href)
    stored_locale.should eq("de")
    client.visit(Accounts::Sessions::IndexPage.href).should have_element("main > h1", text: "Wo Sie angemeldet sind")

    refused = client.submit(Accounts::Language::Update.action, form: {"locale" => "fr"})
    refused.should have_field_error("locale", "unsupported_locale")
    refused.should have_element(".field-error", text: "Ist keine Sprache, die diese App anbietet.")

    client.submit(Accounts::Language::Update.action, form: {"locale" => ""})
    stored_locale.should be_nil
    client.visit(Accounts::Sessions::IndexPage.href).should have_element("main > h1", text: "Where you are signed in")
  end
end
<%- else -%>
describe "the interface's language" do
  it "takes only a language the app offers, and follows the browser again without a choice" do
    client = AccountsSpec.client
    client.submit(Accounts::Language::Update.action, form: {"locale" => "en"}).should redirect_to(Accounts::Sessions::IndexPage.href)
    stored_locale.should eq("en")

    refused = client.submit(Accounts::Language::Update.action, form: {"locale" => "fr"})
    refused.should have_field_error("locale", "unsupported_locale")

    client.submit(Accounts::Language::Update.action, form: {"locale" => ""})
    stored_locale.should be_nil
  end
end
<%- end -%>
