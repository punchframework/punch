module Accounts::Emails
  # An address of the user, as the API shows it.
  struct Address
    include JSON::Serializable

    getter id : Int64
    getter email : Punch::Email
    getter? verified : Bool

    def initialize(identity : Punch::Auth::EmailIdentity)
      @id = identity.id
      @email = identity.email
      @verified = identity.verified?
    end
  end
end
