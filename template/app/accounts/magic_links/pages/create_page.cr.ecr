module Accounts::MagicLinks
  struct CreateView
    include Punch::Component

    def initialize(@sent : Bool)
    end

    def view(v : Punch::View) : Nil
      t = v.t.accounts.magic_links
      v.render <%= app.module_name %>::Layout.new(t.title) do
        v.h1 t.title
        if @sent
          v.p t.sent
        else
          v.p t.intro
          v.form(Create.action) do |form|
            form.field :email
            form.submit t.send_link
          end
        end
        v.p { v.a v.t.accounts.sessions.create.title, href: Accounts::Sessions::CreatePage.href }
      end
    end
  end

  # `GET /accounts/magic_links/new`: asks for the address to mail a
  # sign-in link to; with `sent`, says to check the inbox.
  @[Punch::Public]
  struct CreatePage < Punch::Page
    struct Input
      include Punch::Input

      getter? sent : Bool = false
    end

    alias Output = CreateView

    def call(input : Input, db : Punch::Reader) : Output
      CreateView.new(input.sent?)
    end

    def self.redirect(result : LinkRequested) : Punch::Href
      CreatePage.href(sent: true)
    end
  end
end
