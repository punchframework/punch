    "Billing::PaymentMethods::Card": {
      "version": 1,
      "schema": {
        "$ref": "#/$defs/Billing.PaymentMethods.Card",
        "$defs": {
          "Billing.PaymentMethods.Card": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "card"
              },
              "brand": {
                "type": "string",
                "pattern": "\\S"
              },
              "last4": {
                "type": "string",
                "pattern": "\\S"
              }
            },
            "required": [
              "kind",
              "brand",
              "last4"
            ]
          }
        }
      }
    },
    "Billing::PaymentMethods::Transfer": {
      "version": 1,
      "schema": {
        "$ref": "#/$defs/Billing.PaymentMethods.Transfer",
        "$defs": {
          "Billing.PaymentMethods.Transfer": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "transfer"
              },
              "iban": {
                "type": "string",
                "pattern": "\\S"
              },
              "reference": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "\\S"
              }
            },
            "required": [
              "kind",
              "iban"
            ]
          }
        }
      }
    },
    "Billing::Products::Pricing": {
      "version": 1,
      "schema": {
        "$ref": "#/$defs/Billing.Products.Pricing",
        "$defs": {
          "Billing.Products.Pricing": {
            "type": "object",
            "properties": {
              "unit": {
                "type": "string",
                "pattern": "\\S"
              },
              "prices": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[A-Z]{3}$"
                },
                "additionalProperties": {
                  "type": "integer",
                  "format": "int64",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "maxProperties": 3
              }
            },
            "required": [
              "unit",
              "prices"
            ]
          }
        }
      }
    }
